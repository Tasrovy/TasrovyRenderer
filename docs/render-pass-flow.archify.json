      "variant": "emphasis",
      "route": "straight",
      "labelDy": -52
    },
    {
      "from": "effects_stage",
      "to": "output_stage",
      "label": "HDR / Bloom / Outline",
      "classification": "composite inputs",
      "variant": "emphasis",
      "route": "straight",
      "labelDy": 60
    }
