  "cards": [
    {
      "dot": "amber",
      "title": "实际 Pass 顺序",
      "items": [
        "ShadowCascade* / VirtualShadowPage* → GBuffer → HBAO → HiZHalf / Quarter / Eighth / Sixteenth",
        "Lighting → Transparent → SSR → DepthOfField → TemporalAA | TemporalUpscale → MotionBlur",
        "OutlineTemporal；BloomDownHalf / Quarter / Eighth / Sixteenth → BloomUpEighth / Quarter / Half → PostProcessing"
      ]
    },
    {
      "dot": "emerald",
      "title": "资源与提交关系",
      "items": [
        "ShadowMap / Atlas + GBuffer + SceneDepth → AO、SSR、光照及时域重投影",
        "SceneColor、BloomLowRes、OutlineHistory → PostProcessing → FinalColor",
        "RenderGraph 生成依赖与 Barrier；Scene/UI CommandBuffer 同次 Queue Submit 后 Present"
      ]
    }
  ]
